# Copy this file to .env and fill in your key.

# Which free LLM to use: groq | gemini | ollama
JARVIS_PROVIDER=groq

# Free keys:
#   Groq   -> https://console.groq.com/keys
#   Gemini -> https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: override the default model for the chosen provider
# JARVIS_MODEL=llama-3.3-70b-versatile

# What Jarvis calls you
JARVIS_USER_NAME=Boss

# Wake word(s), comma separated. Add spellings the speech engine tends to produce.
JARVIS_WAKE_WORD=jarvis

# Speaking speed (words per minute) for the offline Windows voice
JARVIS_VOICE_RATE=185

# Phone / Android app link (a token is auto-generated in data/api_token.txt if blank)
JARVIS_API_ENABLED=true
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8765
JARVIS_API_TOKEN=
